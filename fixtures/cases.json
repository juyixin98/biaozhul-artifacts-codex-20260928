        {"from": 2, "to": 3, "capacity": 5},
        {"from": 1, "to": 3, "capacity": 10}
      ]
    },
    "expected": {
      "flow_value": 15,
      "source_side": [0, 1, 2],
      "sink_side": [3],
      "edge_flows": [5, 10, 0, 5, 10]
